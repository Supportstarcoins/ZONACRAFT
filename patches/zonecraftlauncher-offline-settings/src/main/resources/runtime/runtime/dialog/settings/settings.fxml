<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>

<Pane xmlns:fx="http://javafx.com/fxml/1" fx:id="layout" prefWidth="926.0" prefHeight="834.0">
	<stylesheets>
		<URL value="@../dialog.css" />
		<URL value="@settings.css" />
	</stylesheets>

	<!-- Header size: 926, 276 -->
	<Pane fx:id="header" layoutX="0.0" layoutY="0.0" prefWidth="926.0" prefHeight="276.0">
		<!-- Links -->
		<Button styleClass="graphicalButton" fx:id="register" layoutX="43.0" layoutY="194.0" prefWidth="177.0" prefHeight="71.0" focusTraversable="false" />
		<Button styleClass="graphicalButton" fx:id="shop" layoutX="218.0" layoutY="194.0" prefWidth="177.0" prefHeight="71.0" focusTraversable="false" />
		<Button styleClass="graphicalButton" fx:id="buyVIP" layoutX="393.0" layoutY="194.0" prefWidth="177.0" prefHeight="71.0" focusTraversable="false" />
		<Button styleClass="graphicalButton" fx:id="forum" layoutX="568.0" layoutY="194.0" prefWidth="177.0" prefHeight="71.0" focusTraversable="false" />

		<!-- System -->
		<Button styleClass="graphicalButton" fx:id="hide" layoutX="827.0" layoutY="215.0" prefWidth="20.0" prefHeight="20.0" focusTraversable="false" />
		<Button styleClass="graphicalButton" fx:id="close" layoutX="852.0" layoutY="215.0" prefWidth="20.0" prefHeight="20.0" focusTraversable="false" />
	</Pane>

	<!-- Settings -->
	<Label styleClass="title" fx:id="title" layoutX="119.0" layoutY="318.0" prefWidth="679" text="Настройки лаунчера" />
	<CheckBox fx:id="savePassword" layoutX="350.0" layoutY="380.0" prefWidth="255.0" prefHeight="22.0" text="Сохранить пароль" focusTraversable="false" />
	<CheckBox fx:id="shaders" layoutX="350.0" layoutY="408.0" prefWidth="255.0" prefHeight="22.0" text="Клиент с шейдерами" focusTraversable="false" />
	<CheckBox fx:id="fullScreen" layoutX="350.0" layoutY="436.0" prefWidth="255.0" prefHeight="22.0" text="Клиент в полный экран" focusTraversable="false" />
	<CheckBox fx:id="autoEnter" layoutX="350.0" layoutY="464.0" prefWidth="255.0" prefHeight="22.0" text="Автовход на сервер" focusTraversable="false" />

	<!-- Offline settings: only visible on this settings page -->
	<CheckBox fx:id="offlineMode" layoutX="350.0" layoutY="492.0" prefWidth="255.0" prefHeight="22.0" text="Офлайн-режим" focusTraversable="false" />
	<TextField fx:id="offlineNickname" layoutX="350.0" layoutY="520.0" prefWidth="255.0" prefHeight="30.0" promptText="Ник: 3–16 символов" />

	<!-- Memory settings -->
	<Label styleClass="title" fx:id="ramTitle" layoutX="119.0" layoutY="570.0" prefWidth="679" />
	<Slider fx:id="ramSlider" layoutX="119.0" layoutY="595.0" prefWidth="679.0" />

	<!-- Apply settings -->
	<Button styleClass="graphicalButton" fx:id="apply" layoutX="548.0" layoutY="684.0" prefWidth="177.0" prefHeight="71.0" defaultButton="true" focusTraversable="false" />
</Pane>
